{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bzb-419",
  "main": "index.js",
  "compatibility_date": "2026-10-25",
  "workers_dev": true,
  "build": {
    "command": "npm run build"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bzb419",
